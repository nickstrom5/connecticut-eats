DerivedData/
DerivedData*/
build/
xcuserdata/
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# Large, raw or regenerable data (see CLAUDE.md "Rebuild"). Only our own research, the calibration numbers and the
# health-department survey are kept.
data/*.json.gz
data/ct/*
!data/ct/calibration.json
data/app/
data/raw/official/*
!data/raw/official/LHD_COVERAGE.md
!data/raw/official/lhd_coverage.json
!data/raw/official/lhd_restaurants_table.md
data/research/geocode*.json

# Screenshot review copies
docs/screenshots/small-*.png

# The web leaderboard's data carries Google Local 2021-derived ratings and review signals. It is regenerated by
